struct Entity {
    uintptr_t object=0;
    uint64_t uid=0;
    int32_t region=-1,secondary=-1;
    std::string family;
    Json state;
    std::vector<uint64_t> edges,ends;
};
struct Group {uintptr_t object=0;uint64_t uid=0;int32_t region=-1;Json state;std::map<uint64_t,Json> members;};
struct Closure {std::map<uint64_t,Entity> entities;std::map<uint64_t,Group> groups;};
uint64_t identity(Context& c,uintptr_t p,uint64_t ap){type(c,p,ap);auto uid=c.read<uint64_t>(p+0x18);need(uid&&call<uintptr_t>(c,0x47ce20,uid)==p,"Region closure full native UID registry differs");return uid;}
template<class T>std::vector<T> values(Context& c,uintptr_t p,size_t offset,size_t limit=1000000){auto data=c.read<uintptr_t>(p+offset);auto count=c.read<int32_t>(p+offset+8),capacity=c.read<int32_t>(p+offset+12);need(count>=0&&size_t(count)<=limit&&capacity>=count&&capacity<=1000000&&(!capacity||data)&&data<=UINTPTR_MAX-size_t(capacity)*sizeof(T),"Region closure vector extent differs");std::vector<T> out;out.reserve(size_t(count));for(int32_t n=0;n<count;++n)out.push_back(c.read<T>(data+size_t(n)*sizeof(T)));need(c.read<uintptr_t>(p+offset)==data&&c.read<int32_t>(p+offset+8)==count&&c.read<int32_t>(p+offset+12)==capacity,"Region closure vector changed during capture");return out;}
std::vector<uintptr_t> objects(Context& c,uintptr_t p,size_t offset){auto rows=values<uintptr_t>(c,p,offset);std::set<uintptr_t> seen;for(auto row:rows)need(row&&seen.insert(row).second,"Region closure vector contains a null or repeated object");return rows;}
int32_t owner_region(Context& c,const Region& world,uintptr_t p){auto found=std::find(world.all.begin(),world.all.end(),p);need(found!=world.all.end(),"Region closure object owner is outside the complete saved Region roster");return c.read<int32_t>(p+0x834);}
Json geometry(Context& c,uintptr_t p,size_t points,size_t distances){auto a=values<std::array<float,3>>(c,p,points);auto b=values<float>(c,p,distances);need(a.size()==b.size(),"Region closure geometry point/distance counts differ");for(const auto& point:a)for(auto x:point)need(std::isfinite(x),"Region closure geometry contains a nonfinite point");for(float x:b)need(std::isfinite(x),"Region closure geometry contains a nonfinite distance");return {{"points",a},{"distances",b}};}
Json network_connections(Context& c,const Region& world,uintptr_t owner,bool pipe){Json out=Json::array();for(auto p:objects(c,owner,pipe?0x2c0:0x2b0)){type(c,p,0x17251d0);need(c.read<uintptr_t>(p+(pipe?0x160:0x158))==owner&&!c.read<uintptr_t>(p+(pipe?0x158:0x160))&&c.read<uint8_t>(p+0x1a4)==1,"Region closure Network connection reciprocal owner or readiness differs");out.push_back({{"object",p},{"region",owner_region(c,world,c.read<uintptr_t>(p+0x180))},{"waypoint",c.read<int32_t>(p+0x168)},{"position",c.read<std::array<float,3>>(p+0x16c)},{"source_position",c.read<std::array<float,3>>(p+0xf8)},{"pending",c.read<float>(p+0x178)},{"dynamic",c.read<std::array<float,7>>(p+0x188)}});}return out;}
Closure closure(Context& c,const Region& world){Closure out;std::map<uintptr_t,uint64_t> objects_by_pointer;std::map<uintptr_t,std::vector<uintptr_t>> raw_edges,raw_ends;std::map<uintptr_t,int32_t> remote;
    auto add=[&](uintptr_t p,uint64_t ap,const char* family,int32_t region){auto uid=identity(c,p,ap);need(c.read<uintptr_t>(p+0x170)==world.root&&owner_region(c,world,c.read<uintptr_t>(p+0x178))==region,"Region closure root or reciprocal regional owner differs");Entity e{p,uid,region,-1,family,Json::object(),{}, {}};need(objects_by_pointer.emplace(p,uid).second&&out.entities.emplace(uid,e).second,"Region closure object appears in two owned rosters");return uid;};
    for(auto region:world.all){auto id=c.read<int32_t>(region+0x834);auto manager=c.read<uintptr_t>(region+0x9a0);if(manager){need(c.read<uintptr_t>(manager+0x6a0)==region,"Region closure PathManager reciprocal owner differs");for(size_t kind=0;kind<11;++kind){for(auto p:objects(c,manager,0x28+kind*0x30)){auto uid=add(p,0x1743f10,"paths",id);auto& e=out.entities.at(uid);need(c.read<int32_t>(p+0x21c)==int32_t(kind)&&c.read<uint8_t>(p+0x46e)==0,"Region closure Path type or committed state differs");auto second=c.read<uintptr_t>(p+0x2f8);if(second)e.secondary=owner_region(c,world,second);e.state={{"type",kind},{"geometry",geometry(c,p,0x298,0x2b0)}};if(kind==6)e.state["walk"]=geometry(c,p,0x2c8,0x2e0);raw_ends[p]={c.read<uintptr_t>(p+0x268),c.read<uintptr_t>(p+0x270)};}for(auto p:objects(c,manager,0x370+kind*0x48))need(remote.emplace(p,id).second,"Region closure remote Path appears in two Region rosters");}for(size_t kind=0;kind<6;++kind)for(auto p:objects(c,manager,0x238+kind*0x30)){auto uid=add(p,0x1700a10,"path_nodes",id);auto& e=out.entities.at(uid);need(c.read<int32_t>(p+0x298)==int32_t(kind),"Region closure Intersection type differs");e.state={{"type",kind},{"position",c.read<std::array<float,3>>(p+0x110)}};raw_edges[p]=objects(c,p,0x2c8);}}
        manager=c.read<uintptr_t>(region+0x978);if(manager){type(c,manager,0x17141e0);need(c.read<uintptr_t>(manager+0x168)==region,"Region closure NetworkManager reciprocal owner differs");for(auto p:objects(c,manager,0x20)){auto uid=add(p,0x16fc700,"network_nodes",id);auto& e=out.entities.at(uid);need(c.read<uint8_t>(p+0x2eb)==0,"Region closure NetworkNode remains a preview");auto definition=c.read<uintptr_t>(p+0x258);type(c,definition,0x1738010);e.state={{"definition",definition},{"transform",c.read<std::array<float,10>>(p+0x100)},{"definition_values",c.read<std::array<float,5>>(definition+0xc0)},{"connections",network_connections(c,world,p,false)}};raw_edges[p]=objects(c,p,0x268);}std::set<uintptr_t> owned;for(auto p:objects(c,manager,0x50)){owned.insert(p);auto uid=add(p,0x16fca60,"network_pipes",id);auto& e=out.entities.at(uid);need(c.read<uint8_t>(p+0x56e)==1&&c.read<uint8_t>(p+0x56c)==0,"Region closure NetworkPipe is uncommitted or preview");auto definition=c.read<uintptr_t>(p+0x320);type(c,definition,0x17380d0);e.state={{"definition",definition},{"definition_values",c.read<std::array<float,5>>(definition+0xa0)},{"start_position",c.read<std::array<float,3>>(p+0x270)},{"end_position",c.read<std::array<float,3>>(p+0x27c)},{"geometry",geometry(c,p,0x290,0x2a8)},{"connections",network_connections(c,world,p,true)}};raw_ends[p]={c.read<uintptr_t>(p+0x260),c.read<uintptr_t>(p+0x268)};}for(auto p:objects(c,manager,0x80))need(owned.contains(p),"Region closure local NetworkPipe is absent from its owner roster");}}
    for(auto& [uid,e]:out.entities){(void)uid;for(auto p:raw_edges[e.object]){need(objects_by_pointer.contains(p),"Region closure node edge has no saved owner");e.edges.push_back(objects_by_pointer.at(p));}for(auto p:raw_ends[e.object]){need(objects_by_pointer.contains(p),"Region closure segment endpoint has no saved owner");e.ends.push_back(objects_by_pointer.at(p));}if(e.family=="paths"){need(e.ends.size()==2,"Region closure Path endpoint count differs");auto found=remote.find(e.object);need((e.secondary<0&&found==remote.end())||(e.secondary>=0&&found!=remote.end()&&found->second==e.secondary),"Region closure remote Path membership differs");}}
    for(const auto& [uid,e]:out.entities){for(auto end:e.ends){const auto& node=out.entities.at(end);need((node.family==(e.family=="paths"?"path_nodes":"network_nodes"))&&std::count(node.edges.begin(),node.edges.end(),uid)==1,"Region closure segment/node edge reciprocal differs");}for(auto edge:e.edges){const auto& segment=out.entities.at(edge);need(std::count(segment.ends.begin(),segment.ends.end(),uid)==1,"Region closure node/segment endpoint reciprocal differs");}}
    auto manager=c.singleton(0x13df3e0);type(c,manager,0x1700890);type(c,manager+0x18,0x16f0060);for(auto p:array(c,manager+0x18)){auto uid=identity(c,p,0x1749de0);need(c.read<uintptr_t>(p+0x170)==world.root&&!c.read<uintptr_t>(p+0x180),"Region closure Group root or parent differs");Group g;g.object=p;g.uid=uid;g.region=owner_region(c,world,c.read<uintptr_t>(p+0x178));g.state={{"pose",c.read<std::array<float,10>>(p+0x100)}};type(c,p+0x210,0x16ea660);for(auto member:array(c,p+0x210)){type(c,member,0x16fbc40);auto child=c.read<uintptr_t>(member+0x18);auto id=identity(c,child,0x16c1390);need(c.read<uintptr_t>(child+0x180)==p&&c.read<uintptr_t>(child+0x170)==world.root&&owner_region(c,world,c.read<uintptr_t>(child+0x178))==g.region,"Region closure Group/Scenery reciprocal differs");need(g.members.emplace(id,c.read<std::array<float,10>>(member+0x64)).second,"Region closure Group repeats a child UID");}need(out.groups.emplace(uid,g).second,"Region closure Group UID repeats");}return out;
}
std::set<uint64_t> verify_closure(const Closure& before,const Closure& after,int32_t region){std::set<uint64_t> allowed,removed;for(const auto& [uid,e]:before.entities)if(e.region==region||e.secondary==region)allowed.insert(uid);const auto initial=allowed;for(const auto& [uid,e]:before.entities)if(std::any_of(e.ends.begin(),e.ends.end(),[&](auto end){return initial.contains(end);})||std::any_of(e.edges.begin(),e.edges.end(),[&](auto edge){return initial.contains(edge);}))allowed.insert(uid);
    for(const auto& [uid,e]:before.entities)if(!after.entities.contains(uid)){need(allowed.contains(uid),"Region clear removed an unrelated Path or Network UID");removed.insert(uid);}for(const auto& [uid,e]:after.entities){need(before.entities.contains(uid),"Region clear introduced a new Path or Network UID");const auto& old=before.entities.at(uid);need(e.object==old.object&&e.region==old.region&&e.secondary==old.secondary&&e.family==old.family&&e.state==old.state&&e.region!=region&&e.secondary!=region,"Region clear changed surviving Path or Network identity/geometry/owner");auto edges=old.edges;edges.erase(std::remove_if(edges.begin(),edges.end(),[&](auto id){return removed.contains(id);}),edges.end());need(e.edges==edges&&e.ends==old.ends,"Region clear surviving Path or Network references differ");}
    need(before.groups.size()==after.groups.size(),"Region clear changed the global Group roster");for(const auto& [uid,g]:before.groups){need(after.groups.contains(uid),"Region clear lost a Group outside native Scenery member removal");const auto& a=after.groups.at(uid);need(a.object==g.object&&a.region==g.region&&a.state==g.state,"Region clear changed a surviving Group identity or transform");auto expected=g.members;if(g.region==region)expected.clear();need(a.members==expected,"Region clear Group member/relative-pose readback differs");}return removed;
}
