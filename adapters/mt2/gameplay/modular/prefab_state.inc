Census census(Context& c){Census out;out.map=c.singleton(0x13df8c0);type(c,out.map,0x1742860);out.root=out.map+0x1c0;out.regions=raw_list(c,out.map+0x350);std::set<int32_t> ids;for(auto r:out.regions){type(c,r,0x1787930);need(c.read<uintptr_t>(r+0x70)==out.root&&ids.insert(c.read<int32_t>(r+0x834)).second,"Modular complete Region ownership or ID differs");auto manager=c.read<uintptr_t>(r+0x950),scenery=c.read<uintptr_t>(r+0x960);type(c,manager,0x17183c0);type(c,scenery,0x17152d0);need(c.read<uintptr_t>(manager+0x450)==out.root&&c.read<uintptr_t>(manager+0x458)==r&&c.read<uintptr_t>(scenery+0x900)==r&&c.read<uintptr_t>(scenery+0x908)==out.root,"Modular complete prop manager reciprocity differs");auto add=[&](uintptr_t p,bool s,int category){type(c,p,s?0x16c1390:0x16d93c0);object_handle(c,p,s?0x16c1390:0x16d93c0);Prop row;row.object=p;row.uid=c.read<uint64_t>(p+0x18);row.region=r;row.parent=c.read<uintptr_t>(p+0x180);row.scenery=s;need(c.read<uintptr_t>(p+0x170)==out.root&&c.read<uintptr_t>(p+0x178)==r&&(!s||c.read<int32_t>(p+0x268)==category)&&out.props.emplace(row.uid,row).second,"Modular complete prop UID/root/Region/category differs");};for(auto p:list(c,manager+0x408,0x172d7c0))add(p,false,-1);for(int category=0;category<47;++category)for(auto p:list(c,scenery+0x18+size_t(category)*0x30,0x172d6a0))add(p,true,category);}
    for(auto& [uid,row]:out.props){(void)uid;row.saved=saved_prop(c,out,row.object,row.scenery);}need(c.singleton(0x13df8c0)==out.map&&raw_list(c,out.map+0x350)==out.regions,"Modular complete census World changed");return out;
