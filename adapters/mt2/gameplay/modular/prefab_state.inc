struct Census {uintptr_t map=0,root=0;std::vector<uintptr_t> regions;std::map<uint64_t,Prop> props;};
inline std::vector<uintptr_t> raw_list(Context& c,uintptr_t p,size_t limit=100000){auto data=c.read<uintptr_t>(p+8);auto count=c.read<int32_t>(p+16),capacity=c.read<int32_t>(p+20);need(count>=0&&size_t(count)<=limit&&capacity>=count&&capacity<=1000000&&(!capacity||data),"Modular native array extent invalid");std::vector<uintptr_t> rows;std::set<uintptr_t> seen;for(int32_t n=0;n<count;++n){auto value=c.read<uintptr_t>(data+size_t(n)*8);need(value&&seen.insert(value).second,"Modular native array has null or repeated member");rows.push_back(value);}need(c.read<uintptr_t>(p+8)==data&&c.read<int32_t>(p+16)==count&&c.read<int32_t>(p+20)==capacity,"Modular native array changed during read");return rows;}
inline Json object_handle(Context& c,uintptr_t p,uint64_t ap=0){auto uid=c.read<uint64_t>(p+0x18);need(uid!=0,"Modular census UID is zero");Json h={{"epoch",c.epoch},{"uid",std::to_string(uid)}};need(c.resolve(h,ap)==p,"Modular census full UID registry differs");return h;}
