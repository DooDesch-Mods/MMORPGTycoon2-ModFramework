// Quest gameplay is synchronous here. Preserve every live object byte and the
// two owned DailyCount vectors as a private witness; these addresses never enter
// Lua results. This covers fields that an inspection table does not expose.
Json quest_witness(Context& c){auto manager=c.singleton(0x13df410);type(c,manager,0x17020b0);Json out=Json::array();out.push_back(c.read<int32_t>(manager+0x48));auto rows=raw_list(c,manager+0x28,4096);for(auto q:rows){type(c,q,0x174ac10);auto owner=c.read<uintptr_t>(q+0xb8),destination=c.read<uintptr_t>(q+0xf0),op=c.read<uintptr_t>(q+0xc0),dp=c.read<uintptr_t>(q+0xf8);object_handle(c,owner,0x1742980);object_handle(c,destination);need(op&&dp&&c.read<uintptr_t>(op)==owner+0x20&&c.read<uintptr_t>(dp)==destination+0x20,"Modular Quest weak ownership differs");auto owned=raw_list(c,owner+0x860,4096);need(std::find(owned.begin(),owned.end(),q)!=owned.end(),"Modular Quest is absent from its owner list");Json item;item["pointer"]=q;item["bytes"]=c.read<std::array<unsigned char,0x220>>(q);item["name"]=c.text(q+0x38,4096);item["description"]=c.text(q+0x58,65536);item["owner_members"]=owned;item["daily"]=Json::array();for(size_t offset:{size_t(0x100),size_t(0x170)}){auto p=q+offset;type(c,p,0x16e4710);Json daily;daily["words"]=c.read<std::array<int32_t,6>>(p+0x50);for(size_t array_offset:{size_t(0x28),size_t(0x40)}){auto data=c.read<uintptr_t>(p+array_offset);auto count=c.read<int32_t>(p+array_offset+8),capacity=c.read<int32_t>(p+array_offset+12);need(count>=0&&count<=100000&&capacity>=count&&capacity<=1000000&&(!capacity||data),"Modular Quest DailyCount extent differs");Json values=Json::array();for(int32_t n=0;n<count;++n)values.push_back(c.read<int32_t>(data+size_t(n)*4));daily[std::to_string(array_offset)]=values;}item["daily"].push_back(daily);}out.push_back(item);}return out;}
struct Money {int32_t cash;std::array<int32_t,5> record;std::array<std::array<int32_t,2>,20> lines;bool operator==(const Money&)const=default;};
Money money(Context& c){auto b=c.singleton(0x13df220);type(c,b,0x16d97e0);auto r=c.read<uintptr_t>(b+0x100);type(c,r,0x1712c00);need(c.read<int32_t>(r+0x18)==2,"Modular financial record version differs");Money out;out.cash=c.read<int32_t>(b+0x38);out.record=c.read<std::array<int32_t,5>>(r+0x1c);for(size_t n=0;n<20;++n){auto p=r+0x30+n*0x48;type(c,p,0x171d0d0);need(c.read<int32_t>(p+0x20)==int32_t(n),"Modular financial category differs");out.lines[n]=c.read<std::array<int32_t,2>>(p+0x18);}return out;}
Money payment(Money m,int32_t cost,bool refund){need(cost>=0&&(refund||m.cash>=cost),"Modular prefab native price cannot be afforded");auto add=[&](int32_t& x,int64_t delta){auto y=int64_t(x)+delta;need(y>=INT32_MIN&&y<=INT32_MAX,"Modular prefab financial int32 overflow");x=int32_t(y);};if(!cost)return m;int64_t delta=refund?cost:-int64_t(cost);add(m.cash,delta);add(m.record[1],delta);add(m.record[refund?3:4],cost);add(m.lines[6][0],1);add(m.lines[6][1],delta);return m;}
