namespace mt2fw::mt2::gameplay::modular::detail {
Json daily_value(Context& c,uintptr_t p){type(c,p,0x16e4710);Json out={{"words",c.read<std::array<int32_t,6>>(p+0x50)},{"warning",c.read<uint8_t>(p+0x68)}};need(out["warning"].get<int>()<=1,"Modular DailyCount warning is not Boolean");for(size_t offset:{size_t(0x28),size_t(0x40)}){auto data=c.read<uintptr_t>(p+offset);auto count=c.read<int32_t>(p+offset+8),capacity=c.read<int32_t>(p+offset+12);need(count>=0&&count<=100000&&capacity>=count&&capacity<=1000000&&(!capacity||data),"Modular DailyCount vector extent invalid");Json rows=Json::array();for(int32_t n=0;n<count;++n)rows.push_back(c.read<int32_t>(data+size_t(n)*4));out[std::to_string(offset)]=rows;}return out;}
struct Service {uintptr_t object=0;uint64_t uid=0,owner=0,destination=0;int32_t type=0;Json saved,full;};
using Services=std::map<uint64_t,std::vector<Service>>;
Services services(Context& c,const Census& world){Services result;std::set<uint64_t> ids;auto configs=c.read<uintptr_t>(c.image+0x13df840);std::map<std::string,std::array<int32_t,2>> prices;if(configs){type(c,configs,0x173fba0);for(auto p:raw_list(c,configs+0x18,4096)){type(c,p,0x1736660);need(prices.emplace(c.text(p+0x18,4096),c.read<std::array<int32_t,2>>(p+0x50)).second,"Modular Service config name repeats");}}
    for(const auto& [uid,prop]:world.props){if(prop.scenery)continue;auto& rows=result[uid];for(auto p:raw_list(c,prop.object+0x9d0,1024)){type(c,p,0x1718480);object_handle(c,p,0x1718480);need(c.read<uintptr_t>(p+0x148)==prop.object,"Modular Service owner differs");Service row;row.object=p;row.uid=c.read<uint64_t>(p+0x18);row.owner=uid;row.type=c.read<int32_t>(p+0x20);need(ids.insert(row.uid).second&&row.type>=0&&row.type<=16,"Modular Service UID or type differs");auto destination=c.read<uintptr_t>(p+0x130);if(destination){object_handle(c,destination,0x16d93c0);row.destination=c.read<uint64_t>(destination+0x18);need(world.props.contains(row.destination)&&!world.props.at(row.destination).scenery,"Modular Service destination is outside the complete Building census");}auto flags=c.read<std::array<uint8_t,3>>(p+0x48);for(auto f:flags)need(f<=1,"Modular Service flag is not Boolean");auto price=c.read<std::array<int32_t,2>>(p+0x40);auto key=c.text(p+0x158,4096);auto effective=price;if(flags[0]&&prices.contains(key))effective=prices.at(key);row.saved={{"uid",std::to_string(row.uid)},{"owner",std::to_string(uid)},{"destination",std::to_string(row.destination)},{"type",row.type},{"price",effective},{"flags",flags},{"counts",Json::array({daily_value(c,p+0x50),daily_value(c,p+0xc0)})}};row.full=row.saved;row.full["actual_price"]=price;row.full["config_key"]=key;row.full["config"]=c.read<uintptr_t>(p+0x150);row.full["prototype"]=c.read<uintptr_t>(p+0x178);row.full["character"]=c.read<uintptr_t>(p+0x138);row.full["satisfaction"]=c.read<int32_t>(p+0x140);rows.push_back(row);}}
    return result;
}
struct ServiceRemoval {Services survivors;std::map<uint64_t,Service> removed;std::set<uint64_t> related;};
ServiceRemoval service_removal(Services state,uint64_t born){ServiceRemoval out;need(state.contains(born),"Modular Service removal Building is absent");auto save=[&](const Service& row){need(out.removed.emplace(row.uid,row).second,"Modular Service inverse removal repeats a UID");};auto rows=state.at(born);for(const auto& row:rows){save(row);if(!row.destination)continue;need(state.contains(row.destination),"Modular reciprocal Service owner is absent");auto& peers=state.at(row.destination);auto p=std::find_if(peers.begin(),peers.end(),[&](const Service& peer){return peer.type==row.type&&peer.destination==born;});if(p!=peers.end()){need(p->uid!=row.uid,"Modular reciprocal Service is not distinct");save(*p);out.related.insert(row.destination);peers.erase(p);}}state.erase(born);out.survivors=std::move(state);return out;}
void service_survivors(const ServiceRemoval& required,const Services& actual){need(required.survivors.size()==actual.size(),"Modular complete surviving Service owner count differs");for(const auto& [uid,rows]:required.survivors){need(actual.contains(uid)&&actual.at(uid).size()==rows.size(),"Modular Service survivor owner/count differs");for(size_t n=0;n<rows.size();++n)need(rows[n].uid==actual.at(uid)[n].uid&&rows[n].full==actual.at(uid)[n].full,"Modular complete surviving Service fields or order differ");}}
void service_inverse(Context& c,uintptr_t node,const Service& row){type(c,node,0x1737830);need(c.read<uintptr_t>(c.image+0x1737830+0x10)==c.image+0x547370&&c.read<uint64_t>(node+0xb8)==row.uid&&c.read<int32_t>(node+0xc0)==row.type&&c.read<uint64_t>(node+0x1f0)==row.owner&&c.read<uint64_t>(node+0x1f8)==row.destination&&Json(c.read<std::array<int32_t,2>>(node+0xe0))==row.saved.at("price")&&Json(c.read<std::array<uint8_t,3>>(node+0x108))==row.saved.at("flags")&&Json::array({daily_value(c,node+0x110),daily_value(c,node+0x180)})==row.saved.at("counts"),"Modular complete original MakeService inverse differs");}
struct QuestState {uintptr_t manager=0;int32_t completed=0;std::vector<uintptr_t> global;std::map<uint64_t,uintptr_t> owners;std::map<uint64_t,Json> rows;std::map<uintptr_t,Json> values;std::map<uintptr_t,uint64_t> destinations;};
void quest_hash(Context& c,uintptr_t manager,const std::vector<uintptr_t>& rows){auto table=c.read<uintptr_t>(manager+0x18);auto buckets=c.read<int32_t>(manager+0x20),shift=c.read<int32_t>(manager+0x24);need(table&&buckets>0&&buckets<=1000000&&!(buckets&(buckets-1))&&shift>=0&&shift<=31&&uint64_t(buckets)==(uint64_t(1)<<(32-shift)),"Modular Quest manager hash extent differs");std::set<uintptr_t> nodes,keys;for(int32_t n=0;n<buckets;++n){auto node=c.read<uintptr_t>(table+size_t(n)*24+0x10);while(node){need(nodes.insert(node).second&&nodes.size()<=4096,"Modular Quest manager hash repeats a node or exceeds the census budget");auto key=c.read<uintptr_t>(node);auto hash=c.read<uint32_t>(node+8);need(key&&keys.insert(key).second&&hash==uint32_t(key)&&int32_t((hash*0x9e3779ffu)>>shift)==n,"Modular Quest manager hash key or bucket differs");node=c.read<uintptr_t>(node+0x10);}}need(keys==std::set<uintptr_t>(rows.begin(),rows.end()),"Modular Quest manager complete hash/array membership differs");}
QuestState quests(Context& c,const QuestState* seed=nullptr){QuestState out;out.manager=c.singleton(0x13df410);type(c,out.manager,0x17020b0);out.completed=c.read<int32_t>(out.manager+0x48);out.global=raw_list(c,out.manager+0x28,4096);quest_hash(c,out.manager,out.global);need(out.completed>=0&&size_t(out.completed)<=out.global.size(),"Modular Quest completed aggregate differs");if(seed)out.owners=seed->owners;for(auto q:out.global){type(c,q,0x174ac10);auto owner=c.read<uintptr_t>(q+0xb8);object_handle(c,owner,0x1742980);auto uid=c.read<uint64_t>(owner+0x18);need(!out.owners.contains(uid)||out.owners.at(uid)==owner,"Modular Quest owner UID aliases another pointer");out.owners[uid]=owner;}
    std::set<uintptr_t> covered;int32_t completed=0;for(const auto& [uid,owner]:out.owners){need(c.resolve(Json{{"epoch",c.epoch},{"uid",std::to_string(uid)}},0x1742980)==owner&&c.read<int32_t>(owner+0x80c)==0,"Modular Quest owner is stale or not a QuestGiver");auto list=raw_list(c,owner+0x860,4096);Json rows=Json::array();for(size_t n=0;n<list.size();++n){auto q=list[n];type(c,q,0x174ac10);need(covered.insert(q).second&&std::find(out.global.begin(),out.global.end(),q)!=out.global.end()&&c.read<uintptr_t>(q+0xb8)==owner&&c.read<int32_t>(q+0x84)==int32_t(n),"Modular Quest reciprocal ownership or sequence differs");auto destination=c.read<uintptr_t>(q+0xf0);object_handle(c,destination);auto op=c.read<uintptr_t>(q+0xc0),dp=c.read<uintptr_t>(q+0xf8);need(op&&dp&&c.read<uintptr_t>(op)==owner+0x20&&c.read<uintptr_t>(dp)==destination+0x20,"Modular Quest weak ownership differs");auto duid=c.read<uint64_t>(destination+0x18);auto task=c.read<uintptr_t>(q+0x218);int phase=0;if(task){type(c,task,0x1714ac0);auto finished=c.read<uint8_t>(task+0xe);need(finished<=1,"Modular Quest path task status differs");phase=finished?2:1;}Json row={{"name",c.text(q+0x38,4096)},{"description",c.text(q+0x58,65536)},{"type",c.read<int32_t>(q+0x34)},{"action",c.read<int32_t>(q+0x78)},{"kills",c.read<int32_t>(q+0x7c)},{"monster",c.read<int32_t>(q+0x80)},{"sequence",n},{"xp",c.read<int32_t>(q+0x88)},{"gold",c.read<int32_t>(q+0x8c)},{"owner",std::to_string(uid)},{"destination",std::to_string(duid)},{"accepted",daily_value(c,q+0x100)},{"completed",daily_value(c,q+0x170)},{"rating",c.read<std::array<uint32_t,4>>(q+0x1f8)},{"task",phase},{"weak",Json::array({destination,dp,owner,op})}};if(c.read<int32_t>(q+0x1c4)>0)++completed;rows.push_back(row);out.values.emplace(q,row);out.destinations.emplace(q,duid);}out.rows.emplace(uid,rows);}need(covered.size()==out.global.size()&&completed==out.completed,"Modular Quest global membership or completed aggregate differs");return out;
}
struct QuestRemoval {QuestState original;std::set<uint64_t> changed;std::vector<uintptr_t> global;std::map<uint64_t,Json> rows;};
QuestRemoval quest_removal(const QuestState& before,uint64_t born){QuestRemoval out;out.original=before;out.global=before.global;out.rows=before.rows;std::vector<uintptr_t> removed;for(auto q:before.global)if(before.destinations.at(q)==born)removed.push_back(q);for(auto q:removed){auto p=std::find(out.global.begin(),out.global.end(),q);*p=out.global.back();out.global.pop_back();}for(auto& [uid,rows]:out.rows){Json remaining=Json::array();for(auto row:rows)if(row.at("destination")==std::to_string(born))out.changed.insert(uid);else{row["sequence"]=remaining.size();remaining.push_back(row);}rows=remaining;}return out;}
void quest_removed(const QuestRemoval& expected,const QuestState& actual){need(expected.original.manager==actual.manager&&expected.global==actual.global&&expected.rows==actual.rows,"Modular complete Quest removal records or global order differ");}
void quest_inverse(Context& c,uintptr_t node,uint64_t uid,const Json& rows){type(c,node,0x1713330);need(c.read<uintptr_t>(c.image+0x1713330+0x10)==c.image+0x563f50&&c.read<uint64_t>(node+0xb8)==uid&&!c.read<uint8_t>(node+0xc0),"Modular SetNPCQuests inverse owner/method/generation differs");auto data=c.read<uintptr_t>(node+0xd0);auto count=c.read<int32_t>(node+0xd8),capacity=c.read<int32_t>(node+0xdc);need(count>=0&&count<=4096&&capacity>=count&&capacity<=100000&&(!capacity||data),"Modular SetNPCQuests inverse extent differs");size_t n=0;for(const auto& row:rows){if(row.at("action")==8)continue;need(n<size_t(count),"Modular SetNPCQuests inverse definition missing");auto p=data+n++*0x58;need(c.read<int32_t>(p)==row.at("type").get<int32_t>()&&std::to_string(c.read<uint64_t>(p+8))==row.at("destination").get<std::string>()&&c.read<int32_t>(p+0x10)==row.at("action").get<int32_t>()&&c.read<int32_t>(p+0x14)==row.at("kills").get<int32_t>()&&c.text(p+0x18,4096)==row.at("name").get<std::string>()&&c.text(p+0x38,65536)=="[Quest description goes here]","Modular complete SetNPCQuests inverse authored definition differs");}need(n==size_t(count),"Modular SetNPCQuests inverse has extra definitions");}
void quest_restored(const QuestRemoval& original,const QuestState& before,const QuestState& after){need(original.original.manager==before.manager&&before.manager==after.manager&&before.owners==after.owners,"Modular Quest restoration manager or complete owner identities differ");for(const auto& [uid,rows]:before.rows)if(!original.changed.contains(uid))need(after.rows.at(uid)==rows,"Modular Quest restoration changed an unrelated complete owner list");for(auto uid:original.changed){const auto& source=original.original.rows.at(uid);const auto& rows=after.rows.at(uid);size_t index=0;for(const auto& row:source){if(row.at("action")==8)continue;need(index<rows.size(),"Modular restored Quest authored definition missing");const auto& now=rows[index];need(now.at("sequence")==index&&now.at("owner")==row.at("owner"),"Modular restored Quest owner or sequence differs");for(const char* field:{"type","name","action","kills","destination"})need(now.at(field)==row.at(field),std::string("Modular restored Quest authored field differs: ")+field);++index;}need(index==rows.size(),"Modular restored Quest owner contains extra definitions");}
    std::vector<uint64_t> order;for(auto q:after.global){auto uid=std::stoull(after.values.at(q).at("owner").get<std::string>());if(original.changed.contains(uid)&&std::find(order.begin(),order.end(),uid)==order.end())order.push_back(uid);}for(auto uid:original.changed)if(after.rows.at(uid).empty())order.push_back(uid);need(order.size()==original.changed.size(),"Modular restored Quest owner execution coverage differs");auto expected=before.global;for(auto uid:order){for(auto q:before.global)if(before.values.at(q).at("owner")==std::to_string(uid)){auto p=std::find(expected.begin(),expected.end(),q);need(p!=expected.end(),"Modular Quest restoration source member is absent");*p=expected.back();expected.pop_back();}for(auto q:after.global)if(after.values.at(q).at("owner")==std::to_string(uid)){need(std::find(expected.begin(),expected.end(),q)==expected.end(),"Modular Quest restoration reuses a current member");expected.push_back(q);}}need(expected==after.global,"Modular restored Quest complete global swap-last/append order differs");}
void service_restored(const ServiceRemoval& original,const Services& before,const Services& after,uint64_t born){need(after.size()==before.size()+1&&after.contains(born),"Modular restored Service owner count differs");std::map<uint64_t,const Service*> restored;for(const auto& [uid,rows]:after)for(const auto& row:rows)if(original.removed.contains(row.uid)){need(restored.emplace(row.uid,&row).second&&row.saved==original.removed.at(row.uid).saved,"Modular complete restored Service fields differ");}need(restored.size()==original.removed.size(),"Modular restored Service inverse UID coverage differs");for(const auto& [uid,rows]:before){need(after.contains(uid),"Modular unrelated Service owner was removed during restoration");std::vector<const Service*> actual;for(const auto& row:after.at(uid))if(!original.removed.contains(row.uid))actual.push_back(&row);need(actual.size()==rows.size(),"Modular restored Service survivor count differs");for(size_t n=0;n<rows.size();++n)need(rows[n].full==actual[n]->full,"Modular restored Service changed an unrelated full row");}for(const auto& row:after.at(born))need(original.removed.contains(row.uid),"Modular restored Building contains an unowned Service");}
