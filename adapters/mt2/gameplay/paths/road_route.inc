    const auto node=c.read<uintptr_t>(receiver+0x1e8),split=c.read<uintptr_t>(receiver+0x1f0);need(!node || std::any_of(all.nodes.begin(),all.nodes.end(),[&](const auto& row){return row.pointer==node && row.region==region;}),"Road route native snapped Intersection is outside the current Region");need(!split || std::any_of(all.paths.begin(),all.paths.end(),[&](const auto& row){return row.pointer==split && row.region==region;}),"Road route native split Path is outside the current Region");
    if(args.contains(node_key))need(node==c.resolve(args.at(node_key),0x1700a10),"Road route native snap differs from the requested Intersection");if(args.contains(split_key))need(split==c.resolve(args.at(split_key),0x1743f10),"Road route native split differs from the requested Path");
}
