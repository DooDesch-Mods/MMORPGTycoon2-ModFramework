    RoutePreview p;p.ghost=c.read<uintptr_t>(receiver+0x1a8);need(p.ghost && c.read<uintptr_t>(p.ghost)==c.image+0x1743f10 && c.read<uintptr_t>(p.ghost+0x178)==region && c.read<uint8_t>(p.ghost+0x46e)==1 && c.read<uint8_t>(receiver+0x230)==1,"Road route native preview is absent or invalid");
