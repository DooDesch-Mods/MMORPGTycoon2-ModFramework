    for(const auto& n:all.nodes){Json edges=Json::array();for(auto p:n.edges)edges.push_back(identity(c.epoch,path_uids.at(p)));std::sort(edges.begin(),edges.end(),[](const auto& a,const auto& b){return a.at("uid").template get<std::string>()<b.at("uid").template get<std::string>();});nodes.push_back({{"handle",identity(c.epoch,n.uid)},{"region",region_id(all,n.region)},{"type",n.type},{"position",n.position},{"edges",edges}});}
