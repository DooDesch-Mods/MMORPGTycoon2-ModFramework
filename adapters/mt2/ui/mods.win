mmoWindow {
    id "mt2fw_mods";
    dims 880 560;
    anchorType Window;
    anchorPos 90 40;
    hasTitlebar true;
    title "Mods";
    material "mt2fw_ui_base";
    corners "BottomRight";
    cornerSize 12;
    hideOnEscape true;
    transitionType rez;
    rezSpeed normal;
    content {
        mmoPane
        {
            id "brand_icon";
            anchorType TopLeft;
            anchorPos 24 18;
            dims 40 40;
            material "mt2fw_desktop_mods";
            color 1 1 1 1;
            clickable false;
            border false;
        }
        mmoTextPane
        {
            id "brand";
            anchorType TopLeft;
            anchorPos 80 14;
            dims 600 34;
            text "MT2 Mod Framework";
            size 24;
            textColor 0.89 0.95 0.98 1;
            bold true;
            justify topleft;
            editable false;
            clickable false;
            border false;
        }
        mmoTextPane
        {
            id "summary";
            anchorType TopLeft;
            anchorPos 80 48;
            dims 600 24;
            text "Installed mods";
            size 14;
            textColor 0.63 0.79 0.86 1;
            bold false;
            justify topleft;
            editable false;
            clickable false;
            border false;
