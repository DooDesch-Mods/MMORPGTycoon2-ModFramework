{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mt2fw:content:1.0.0",
  "title": "MT2 static content definitions",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "variant",
      "model",
      "material"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "variant": {
        "type": "string",
        "minLength": 1
      },
      "model": {
        "type": "string",
        "minLength": 1
      },
      "material": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": true
  }
}
